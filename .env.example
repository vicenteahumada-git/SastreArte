POSTGRES_DB=sastrearte
POSTGRES_USER=sastrearte
POSTGRES_PASSWORD=sastrearte_local
DATABASE_URL=postgresql://sastrearte:sastrearte_local@postgresql:5432/sastrearte

# Tamano del pool de conexiones a PostgreSQL.
DB_POOL_MIN=1
DB_POOL_MAX=10

# Alicuota de IVA vigente (0.19 = 19 %). No se guarda en la base: se aplica
# al calcular los totales de cada pedido.
TASA_IVA=0.19

# Origenes habilitados para llamar a la API, separados por coma.
CORS_ORIGINS=http://localhost:5173

# Zona horaria del taller: define que dia es "hoy" al validar fechas.
ZONA_HORARIA=America/Santiago

# El frontend llama a /api sobre su propio origen; Vite lo redirige al backend.
# Asi funciona igual en localhost, desde otro equipo de la red o por un tunel.
VITE_API_URL=/api
VITE_API_PROXY=http://backend:8000

